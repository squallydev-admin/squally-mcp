{
  "name": "squally-mcp",
  "version": "0.1.1",
  "description": "Local MCP server for Squally — read-only access to your Playwright test runs, flaky tests and failures.",
  "license": "MIT",
  "author": "Squally",
  "homepage": "https://docs.squally.dev/agents/mcp-server/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/squallydev-admin/squally-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/squallydev-admin/squally-mcp/issues"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "playwright",
    "flaky-tests",
    "squally"
  ],
  "type": "module",
  "bin": {
    "squally-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    },
    "./instructions": {
      "types": "./dist/instructions.d.ts",
      "default": "./dist/instructions.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "vendor:openapi": "node scripts/vendor-openapi.mjs",
    "test": "npm run build && node --test \"test/**/*.test.js\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
